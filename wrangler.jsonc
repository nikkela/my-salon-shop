{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-salon-shop",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "vars": {
    // One-click / bypass sign in. Set to "false" before going live.
    "QUICK_LOGIN": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salon-db",
      "database_id": "ac2bb0d5-b173-475b-ab5f-0c401434d8a2",
      "migrations_dir": "migrations"
    }
  ]
}
